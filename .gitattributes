# Preserve fixture bytes; never normalize compressed archive parts.
* text=auto
*.part -text
# Regression snapshots must retain the exact bytes captured by the test runner.
/regression-expectations/**/*.snap -text
# Native print output includes an empty tab-separated field.
/regression-expectations/deadlib-lua/lua51_table_order.txt -whitespace
# This pinned upstream source is covered by a provenance checksum.
/itgmania-song-lua-micro/actor-definition-source/*.lua -text
# Native song Lua controls include checksums of their exact source bytes.
/regression-expectations/song-lua/**/*.lua -text
/regression-expectations/song-lua/native-actor-parity/*.sm -text
*.gz -text
.githooks/* text eol=lf
