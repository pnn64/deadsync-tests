diff --git a/crates/deadsync-gameplay/src/stage_life.rs b/crates/deadsync-gameplay/src/stage_life.rs
new file mode 100644
index 000000000..d2b2f3ab5
--- /dev/null
+++ b/crates/deadsync-gameplay/src/stage_life.rs
@@ -0,0 +1,80 @@
+/// PlayerStageStats history uses accumulated steps time, independently of the
+/// music-time history used by the gameplay graph.
+#[derive(Clone, Debug, Default)]
+pub struct StageLifeRecord {
+    pub steps_seconds: f32,
+    pub samples: Vec<(f32, f32)>,
+}
+
+impl StageLifeRecord {
+    pub fn with_capacity(capacity: usize) -> Self {
+        Self {
+            steps_seconds: 0.0,
+            samples: Vec::with_capacity(capacity),
+        }
+    }
+
+    pub fn copy_from(&mut self, source: &Self) {
+        self.steps_seconds = source.steps_seconds;
+        self.samples.clone_from(&source.samples);
+    }
+
+    pub fn clear(&mut self) {
+        self.steps_seconds = 0.0;
+        self.samples.clear();
+    }
+
+    /// Player::ChangeLife(TapNoteScore/HoldNoteScore) records the resulting life
+    /// once. Its float ChangeLife/SetLife overloads record before and after.
+    pub fn record(&mut self, life: f32) {
+        let seconds = self.steps_seconds;
+        if seconds < 0.0 {
+            return;
+        }
+        let index = self.samples.partition_point(|&(time, _)| time < seconds);
+        if let Some(&(time, previous)) = self.samples.get(index)
+            && time == seconds
+            && previous != life
+        {
+            self.set_sample(seconds - 0.00390625, previous);
+        }
+        self.set_sample(seconds, life);
+        let len = self.samples.len();
+        if len >= 3
+            && self.samples[len - 3].1 == self.samples[len - 2].1
+            && self.samples[len - 2].1 == self.samples[len - 1].1
+        {
+            self.samples.remove(len - 2);
+        }
+    }
+
+    fn set_sample(&mut self, seconds: f32, life: f32) {
+        let index = self.samples.partition_point(|&(time, _)| time < seconds);
+        if self
+            .samples
+            .get(index)
+            .is_some_and(|&(time, _)| time == seconds)
+        {
+            self.samples[index].1 = life;
+        } else {
+            self.samples.insert(index, (seconds, life));
+        }
+    }
+
+    /// PlayerStageStats::GetLifeRecordLerpAt and RageUtil's float SCALE order.
+    pub fn sample(&self, seconds: f32) -> f32 {
+        if self.samples.is_empty() {
+            return 0.0;
+        }
+        let later = self.samples.partition_point(|&(time, _)| !(seconds < time));
+        let earlier = later.saturating_sub(1);
+        let (from, before) = self.samples[earlier];
+        let Some(&(to, after)) = self.samples.get(later) else {
+            return before;
+        };
+        if from == to {
+            return before;
+        }
+        (seconds - from) * (after - before) / (to - from) + before
+    }
+}
diff --git a/crates/deadsync-gameplay/src/stage_score.rs b/crates/deadsync-gameplay/src/stage_score.rs
new file mode 100644
index 000000000..50799c02b
--- /dev/null
+++ b/crates/deadsync-gameplay/src/stage_score.rs
@@ -0,0 +1,84 @@
+/// ScoreKeeperNormal's integer counter, separate from percentage dance points.
+/// Simply Love enables internal scoring, W1, no combo bonus, and unit rounding.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct StageScore {
+    pub score: u32,
+    pub current_max_score: u32,
+    pub configured: bool,
+    total: u64,
+    judged: u64,
+    maximum: i64,
+    bonus: i64,
+}
+
+impl StageScore {
+    pub fn for_song(total: usize, music_seconds: f32) -> Self {
+        // Song::IsLong/IsMarathon use the actual audio length and inclusive
+        // native default thresholds; marathon excludes the long-song branch.
+        let stages = if music_seconds >= 300.0 {
+            3
+        } else if music_seconds >= 150.0 {
+            2
+        } else {
+            1
+        };
+        let maximum = 100_000_000 * stages;
+        Self {
+            configured: true,
+            total: total as u64,
+            maximum,
+            bonus: maximum,
+            ..Self::default()
+        }
+    }
+
+    pub fn reset(&mut self) {
+        self.score = 0;
+        self.current_max_score = 0;
+        self.judged = 0;
+        self.bonus = self.maximum;
+    }
+
+    pub fn tap(&mut self, grade: JudgeGrade, failed: bool) {
+        if !self.configured || self.total == 0 {
+            return;
+        }
+        let weight = match grade {
+            JudgeGrade::Fantastic => 10,
+            JudgeGrade::Excellent => 9,
+            JudgeGrade::Great => 5,
+            _ => 0,
+        };
+        self.judged += 1;
+        let denominator = self.total * (self.total + 1) / 2;
+        let points =
+            |weight: u64| (weight * self.judged * (self.maximum / 10) as u64 / denominator) as u32;
+        if failed {
+            self.score = self.score.wrapping_add(weight as u32);
+            if weight > 0 {
+                self.score = (self.score.wrapping_add(2) / 5).wrapping_mul(5);
+            }
+        } else {
+            self.score = self.score.wrapping_add(points(weight));
+        }
+        let possible = points(10);
+        self.bonus -= i64::from(possible);
+        self.current_max_score = self.current_max_score.wrapping_add(possible);
+        if self.judged == self.total
+            && matches!(grade, JudgeGrade::Fantastic | JudgeGrade::Excellent)
+        {
+            if !failed {
+                self.score = self.score.wrapping_add(self.bonus as u32);
+            }
+            self.current_max_score = self.current_max_score.wrapping_add(self.bonus as u32);
+        }
+    }
+
+    pub fn hold(&mut self, result: HoldResult, failed: bool) {
+        match result {
+            HoldResult::Held => self.tap(JudgeGrade::Fantastic, failed),
+            HoldResult::LetGo => self.tap(JudgeGrade::Decent, failed),
+            HoldResult::Missed => {}
+        }
+    }
+}
