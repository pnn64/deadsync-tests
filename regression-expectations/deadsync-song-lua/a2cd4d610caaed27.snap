test: mesh_upload_conversion_and_count_rules_keep_existing_fallbacks
("construction", [])
("a:SetVertices({});log(a:GetNumVertices())", [48])
("a:SetVertices({false,{{1,2,3},{1,0,0},{0,1}},{{3,4}},{{5,6}}});log(a:GetNumVertices())", [48, 124, 52])
("a:SetVertices({{{'1','2','3'},{'0x1','0.5','1',nil},{'.1','.2'}},{{4,5},'#ff00ff',{0/0,1}},{{8,9,1/0},string.char(255)}});log(a:GetNumVertices())", [48, 124, 52, 124, 51])
("a:SetVertices({{{0/0,2,-3},{1,1,1,1},{0,1}},{{3,4,5}},{{6,7,8}}});log(a:GetNumVertices())", [48, 124, 52, 124, 51, 124, 51])
("a:SetVertices({{{1,2}},{{3,4}},{{5,6}},[8]={{10,12}}});log(a:GetNumVertices())", [48, 124, 52, 124, 51, 124, 51, 124, 51])
("a:SetNumVertices(3.5);log(a:GetNumVertices())", [48, 124, 52, 124, 51, 124, 51, 124, 51, 124, 52])
("a:SetNumVertices('2.5');log(a:GetNumVertices())", [48, 124, 52, 124, 51, 124, 51, 124, 51, 124, 52, 124, 51])
("a:SetNumVertices(false);log(a:GetNumVertices())", [48, 124, 52, 124, 51, 124, 51, 124, 51, 124, 52, 124, 51, 124, 48])
("a:SetNumVertices(-7);log(a:GetNumVertices())", [48, 124, 52, 124, 51, 124, 51, 124, 51, 124, 52, 124, 51, 124, 48, 124, 48])
("a:SetNumVertices('inf');log(a:GetNumVertices())", [48, 124, 52, 124, 51, 124, 51, 124, 51, 124, 52, 124, 51, 124, 48, 124, 48, 124, 50, 49, 52, 55, 52, 56, 51, 54, 52, 55])
("a:SetNumVertices('nan');log(a:GetNumVertices())", [48, 124, 52, 124, 51, 124, 51, 124, 51, 124, 52, 124, 51, 124, 48, 124, 48, 124, 50, 49, 52, 55, 52, 56, 51, 54, 52, 55, 124, 48])
("a:SetNumVertices(1e50);log(a:GetNumVertices())", [48, 124, 52, 124, 51, 124, 51, 124, 51, 124, 52, 124, 51, 124, 48, 124, 48, 124, 50, 49, 52, 55, 52, 56, 51, 54, 52, 55, 124, 48, 124, 50, 49, 52, 55, 52, 56, 51, 54, 52, 55])
("a:SetVertices(vertices);a:SetVertices(false);a.__songlua_vertex_count='4.9';log(a:GetNumVertices());a.__songlua_vertex_count=1/0;assert(not pcall(a.GetNumVertices,a));a.__songlua_vertex_count=nil;a.__songlua_vertices=vertices;log(a:GetNumVertices())", [48, 124, 52, 124, 51, 124, 51, 124, 51, 124, 52, 124, 51, 124, 48, 124, 48, 124, 50, 49, 52, 55, 52, 56, 51, 54, 52, 55, 124, 48, 124, 50, 49, 52, 55, 52, 56, 51, 54, 52, 55, 124, 52, 124, 54])
test: uploaded_buffer_collection_after_successful_and_failed_queries
("construction", [])
("a:SetVertices(vertices);weak=setmetatable({a.__songlua_vertices},{__mode='v'});a.__songlua_vertices=nil;collectgarbage('collect');collectgarbage('collect');assert(weak[1]==nil,'without mesh query')", [])
("construction", [])
("a:SetVertices(vertices);weak=setmetatable({a.__songlua_vertices},{__mode='v'})", [])
("a.__songlua_vertices=nil;collectgarbage('collect');collectgarbage('collect');assert(weak[1]==nil,'after success query')", [])
("construction", [])
("a:SetVertices(vertices);weak=setmetatable({a.__songlua_vertices},{__mode='v'})", [])
("a.__songlua_vertex_count=nil;assert(not pcall(a.GetNumVertices,a));a.__songlua_vertex_count=6", [])
("a.__songlua_vertices=nil;collectgarbage('collect');collectgarbage('collect');assert(weak[1]==nil,'after failure query')", [])
test: vertex_uploads_copy_scalars_and_survive_collection
("construction", [])
("assert(a:GetTexture():GetPath()=='');assert(a:GetTexture():GetSourceWidth()==1);assert(a:SetVertices(vertices)==a);assert(type(a.__songlua_vertices)=='userdata');assert(a:GetNumVertices()==6);log(a:GetNumVertices(),a:GetDestDrawMode())", [54, 124, 110, 105, 108])
("for key in pairs(MESSAGEMAN) do assert(type(key)~='userdata') end", [54, 124, 110, 105, 108])
("vertices[1][1][1]=900;vertices[1][2][4]=0;vertices[2]=false;collectgarbage('collect');log(a:GetNumVertices())", [54, 124, 110, 105, 108, 124, 54])
("saved=a.__songlua_vertices;b.__songlua_vertices=saved;b:SetNumVertices(99);a:SetVertices({});collectgarbage('collect');log(a:GetNumVertices(),b:GetNumVertices())", [54, 124, 110, 105, 108, 124, 54, 124, 48, 124, 57, 57])
("a.__songlua_vertices=saved;a.__songlua_vertex_count=nil;assert(not pcall(a.GetNumVertices,a));a.__songlua_vertex_count=6;log(a:GetNumVertices())", [54, 124, 110, 105, 108, 124, 54, 124, 48, 124, 57, 57, 124, 54])
("weak=setmetatable({saved},{__mode='v'});saved=nil;a.__songlua_vertices=nil;b.__songlua_vertices=nil;collectgarbage('collect');collectgarbage('collect');assert(weak[1]==nil)", [54, 124, 110, 105, 108, 124, 54, 124, 48, 124, 57, 57, 124, 54])
("\n        local mt=getmetatable(a);local assign=mt.__newindex\n        mt.__newindex=function(self,key,value)\n            if key=='__songlua_vertices' then\n                weak[2]=value;collectgarbage('collect');assert(weak[2]==value);error('rejected upload')\n            end\n            rawset(self,key,value)\n        end\n        assert(not pcall(a.SetVertices,a,vertices));assert(a:GetNumVertices()==6)\n        mt.__newindex=assign;collectgarbage('collect');collectgarbage('collect');assert(weak[2]==nil)\n    ", [54, 124, 110, 105, 108, 124, 54, 124, 48, 124, 57, 57, 124, 54])
