song/tests/rust_meshes.rs::observations
test: copied_texture_handle_retains_identity_and_metadata_across_gc_and_reload
("construction", [])
("\n        copied=a:GetTexture()\n        b:SetTexture(copied)\n        assert(b:GetTexture() == copied)\n        collectgarbage('collect')\n        log(b:GetTexture():GetPath(),b:GetTexture():GetTextureWidth(),b:GetTexture():GetTextureHeight())\n        a:LoadTexture(nil)\n        assert(b:GetTexture() == copied)\n        assert(a:GetTexture() ~= copied)\n        log(copied:GetNumFrames(),b:GetTexture():GetNumFrames())\n        b:LoadTexture(nil)\n        assert(b:GetTexture() ~= copied and b:GetTexture():GetPath() == '')\n        log(b:GetTexture():GetTextureWidth(),b:GetTexture():GetTextureHeight())\n        ", [124, 49, 124, 49, 124, 49, 124, 49, 124, 49, 124, 49])
test: draw_state_getters_reenter_collect_and_keep_partial_writes
("construction", [])
("\n        a:SetVertices(vertices)\n        local reads=0\n        a:SetDrawState(setmetatable({}, {__index=function(self,key)\n            b:aux(b:getaux()+1);collectgarbage('collect')\n            if key=='Mode' then reads=reads+1;return reads==1 and 'DrawMode_Quads' or 'DrawMode_Fan' end\n            return key=='First' and 2 or 4\n        end}));log(a:GetDestDrawMode(),a.__songlua_draw_state.Mode)\n        local original=a.__songlua_draw_state\n        assert(not pcall(a.SetDrawState,a,setmetatable({}, {__index=function(self,key)\n            collectgarbage('collect');if key=='Mode' then return 'DrawMode_Triangles' end;error('range failure')\n        end})))\n        assert(a.__songlua_draw_state==original);log(original.Mode,a:GetDestDrawMode())\n    ", [68, 114, 97, 119, 77, 111, 100, 101, 95, 70, 97, 110, 124, 68, 114, 97, 119, 77, 111, 100, 101, 95, 81, 117, 97, 100, 115, 124, 68, 114, 97, 119, 77, 111, 100, 101, 95, 84, 114, 105, 97, 110, 103, 108, 101, 115, 124, 68, 114, 97, 119, 77, 111, 100, 101, 95, 70, 97, 110])
("a.__songlua_draw_state=setmetatable({}, {__index=function(self,key) b:aux(b:getaux()+1);collectgarbage('collect');error('ignored range failure') end})", [68, 114, 97, 119, 77, 111, 100, 101, 95, 70, 97, 110, 124, 68, 114, 97, 119, 77, 111, 100, 101, 95, 81, 117, 97, 100, 115, 124, 68, 114, 97, 119, 77, 111, 100, 101, 95, 84, 114, 105, 97, 110, 103, 108, 101, 115, 124, 68, 114, 97, 119, 77, 111, 100, 101, 95, 70, 97, 110])
("a.__songlua_draw_state=nil;assert(not pcall(a.SetDrawState,a,{Mode=false,First=2}));assert(a.__songlua_draw_state.Mode==false);log(a:GetDestDrawMode())", [68, 114, 97, 119, 77, 111, 100, 101, 95, 70, 97, 110, 124, 68, 114, 97, 119, 77, 111, 100, 101, 95, 81, 117, 97, 100, 115, 124, 68, 114, 97, 119, 77, 111, 100, 101, 95, 84, 114, 105, 97, 110, 103, 108, 101, 115, 124, 68, 114, 97, 119, 77, 111, 100, 101, 95, 70, 97, 110, 124, 68, 114, 97, 119, 77, 111, 100, 101, 95, 70, 97, 110])
("a.__songlua_draw_state=nil;a:SetDrawState{Mode='DrawMode_Triangles'};a.__songlua_vertices=nil;local mt=getmetatable(a);local lookup=mt.__index;mt.__index=function(self,key) if key=='__songlua_vertices' then collectgarbage('collect');return vertices end;return lookup(self,key) end", [68, 114, 97, 119, 77, 111, 100, 101, 95, 70, 97, 110, 124, 68, 114, 97, 119, 77, 111, 100, 101, 95, 81, 117, 97, 100, 115, 124, 68, 114, 97, 119, 77, 111, 100, 101, 95, 84, 114, 105, 97, 110, 103, 108, 101, 115, 124, 68, 114, 97, 119, 77, 111, 100, 101, 95, 70, 97, 110, 124, 68, 114, 97, 119, 77, 111, 100, 101, 95, 70, 97, 110])
