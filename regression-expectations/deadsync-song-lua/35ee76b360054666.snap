("\n            assert(RollingNumbers==nil and BPMDisplay==nil and DeviceList==nil and InputList==nil)\n            assert(rolling:GetText()=='start' and bpm:GetText()=='')\n            assert(devices:GetText()=='No input devices' and inputs:GetText()=='No unmapped inputs')\n            for _,a in ipairs{rolling,bpm,devices,inputs} do\n                assert(a.GetText~=nil and a.SetUpdateFunction==nil and a.SetDrawFunction==nil and a.GetDrawFunction==nil)\n                assert(a.PixelFont==nil and a.NoStroke==nil and a.UnknownMethod==nil)\n                assert(a:GetTargetNumber()==0)\n                a:settext('text'):AddAttribute(0,{Length=-1,Diffuse={.1,.2,.3,.4}}):strokecolor({.4,.3,.2,.1})\n            end\n            assert(rolling:Load('RollingNumbersEvaluationA')==rolling)\n            assert(rolling:targetnumber(12)==rolling and rolling:GetText()=='0012' and rolling:GetTargetNumber()==12)\n            rolling:Load('RollingNumbersEvaluationB');assert(rolling:GetText()=='0012')\n            rolling:SetTargetNumber(7);assert(rolling:GetText()=='007')\n        ", [SongLuaOverlayState { aux: 0.0, x: 0.0, y: 0.0, z: 0.0, z_bias: 0.0, draw_order: 0, draw_by_z_position: false, aft_created: false, aft_preserve: false, halign: 0.5, valign: 0.5, text_align: Center, uppercase: false, shadow_len: [0.0, 0.0], shadow_color: [0.0, 0.0, 0.0, 0.5], glow: [1.0, 1.0, 1.0, 0.0], fov: None, vanishpoint: None, diffuse: [1.0, 1.0, 1.0, 1.0], vertex_colors: None, visible: true, hibernating: false, cropleft: 0.0, cropright: 0.0, croptop: 0.0, cropbottom: 0.0, fadeleft: 0.0, faderight: 0.0, fadetop: 0.0, fadebottom: 0.0, mask_source: false, mask_dest: false, depth_test: false, depth_write: false, depth_test_on_fail: false, cull_mode: None, zoom: 1.0, zoom_x: 1.0, zoom_y: 1.0, zoom_z: 1.0, basezoom: 1.0, basezoom_x: 1.0, basezoom_y: 1.0, basezoom_z: 1.0, scale_factors: None, rot_x_deg: 0.0, rot_y_deg: 0.0, rot_z_deg: 0.0, base_rotation: [0.0, 0.0, 0.0], quaternion: [0.0, 0.0, 0.0,