("b:SetTextureName('second'):Create();root.ScriptErrorMessageCommand=function(self,p) log(p.message);a:Create();b:Create() end;a:Create();assert(__songlua_reporting_script_error==false) / a", FrameTexture { capture_name: "shared", capture_size: Some([12.0, 8.0]), alpha_buffer: false, depth_buffer: false, float_buffer: false })
("b:SetTextureName('second'):Create();root.ScriptErrorMessageCommand=function(self,p) log(p.message);a:Create();b:Create() end;a:Create();assert(__songlua_reporting_script_error==false) / b", FrameTexture { capture_name: "second", capture_size: Some([1.0, 1.0]), alpha_buffer: false, depth_buffer: false, float_buffer: false })
("root.ScriptErrorMessageCommand=function() error('report failure') end;assert(not pcall(a.Create,a));assert(__songlua_reporting_script_error==false);root.ScriptErrorMessageCommand=function(self,p) log(p.message) end;a:Create() / a", FrameTexture { capture_name: "shared", capture_size: Some([12.0, 8.0]), alpha_buffer: false, depth_buffer: false, float_buffer: false })
("root.ScriptErrorMessageCommand=function() error('report failure') end;assert(not pcall(a.Create,a));assert(__songlua_reporting_script_error==false);root.ScriptErrorMessageCommand=function(self,p) log(p.message) end;a:Create() / b", FrameTexture { capture_name: "second", capture_size: Some([1.0, 1.0]), alpha_buffer: false, depth_buffer: false, float_buffer: false })
