test: malformed_allocation_reads_recover_without_stale_output
("a=root[1];b=root[2];sprite=root[3] / a", FrameTexture { capture_name: "ActorFrameTexture 1", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("a=root[1];b=root[2];sprite=root[3] / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("a:Create();allocation=a.__songlua_aft_allocation / a", FrameTexture { capture_name: "ActorFrameTexture 1", capture_size: Some([1.0, 1.0]), alpha_buffer: false, depth_buffer: false, float_buffer: false })
("a:Create();allocation=a.__songlua_aft_allocation / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("a.__songlua_aft_allocation=false;assert(not pcall(a.GetTexture,a)) / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("a.__songlua_aft_allocation=allocation / a", FrameTexture { capture_name: "ActorFrameTexture 1", capture_size: Some([1.0, 1.0]), alpha_buffer: false, depth_buffer: false, float_buffer: false })
("a.__songlua_aft_allocation=allocation / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("allocation.name=false / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("allocation.name='restored';allocation.size={4,5} / a", FrameTexture { capture_name: "restored", capture_size: Some([4.0, 5.0]), alpha_buffer: false, depth_buffer: false, float_buffer: false })
("allocation.name='restored';allocation.size={4,5} / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("allocation.size=false / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("allocation.name='restored';allocation.size={4,5} / a", FrameTexture { capture_name: "restored", capture_size: Some([4.0, 5.0]), alpha_buffer: false, depth_buffer: false, float_buffer: false })
("allocation.name='restored';allocation.size={4,5} / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("allocation.size=nil / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("allocation.name='restored';allocation.size={4,5} / a", FrameTexture { capture_name: "restored", capture_size: Some([4.0, 5.0]), alpha_buffer: false, depth_buffer: false, float_buffer: false })
("allocation.name='restored';allocation.size={4,5} / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("allocation.size={false,5} / a", FrameTexture { capture_name: "restored", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("allocation.size={false,5} / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("assert(not pcall(a.GetTexture,a));allocation.size={4,5};texture(a:GetTexture()) / a", FrameTexture { capture_name: "restored", capture_size: Some([4.0, 5.0]), alpha_buffer: false, depth_buffer: false, float_buffer: false })
("assert(not pcall(a.GetTexture,a));allocation.size={4,5};texture(a:GetTexture()) / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
test: texture_handle_equality_and_collection_keep_captured_metadata
("a=root[1];b=root[2];sprite=root[3] / a", FrameTexture { capture_name: "ActorFrameTexture 1", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("a=root[1];b=root[2];sprite=root[3] / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("a:Create();b:Create();local x=a:GetTexture();local y=a:GetTexture();assert(x==y,'same allocation');assert(x~=b:GetTexture(),'different allocations');saved=x;weak=setmetatable({y},{__mode='v'});y=nil;collectgarbage();collectgarbage();texture(saved) / a", FrameTexture { capture_name: "ActorFrameTexture 1", capture_size: Some([1.0, 1.0]), alpha_buffer: false, depth_buffer: false, float_buffer: false })
("a:Create();b:Create();local x=a:GetTexture();local y=a:GetTexture();assert(x==y,'same allocation');assert(x~=b:GetTexture(),'different allocations');saved=x;weak=setmetatable({y},{__mode='v'});y=nil;collectgarbage();collectgarbage();texture(saved) / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: Some([1.0, 1.0]), alpha_buffer: false, depth_buffer: false, float_buffer: false })
("a.__songlua_aft_allocation.name='changed';a.__songlua_aft_allocation.size={17,9};texture(saved);texture(a:GetTexture());assert(saved~=a:GetTexture());saved:loop(false):rate(2) / a", FrameTexture { capture_name: "changed", capture_size: Some([17.0, 9.0]), alpha_buffer: false, depth_buffer: false, float_buffer: false })
("a.__songlua_aft_allocation.name='changed';a.__songlua_aft_allocation.size={17,9};texture(saved);texture(a:GetTexture());assert(saved~=a:GetTexture());saved:loop(false):rate(2) / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: Some([1.0, 1.0]), alpha_buffer: false, depth_buffer: false, float_buffer: false })
