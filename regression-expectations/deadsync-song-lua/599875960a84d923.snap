test: lua_error_service_preserves_message_reentry_gc_and_failure_cleanup
("a=root[1];b=root[2];sprite=root[3] / a", FrameTexture { capture_name: "ActorFrameTexture 1", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("a=root[1];b=root[2];sprite=root[3] / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("\n            local report=lua.ReportScriptError\n            root.ScriptErrorMessageCommand=function(self,p)\n                collectgarbage();log(p.message);report('nested error suppressed')\n            end\n            report('outer error')\n            assert(__songlua_reporting_script_error==false)\n            root.ScriptErrorMessageCommand=function()error('handler failure')end\n            assert(not pcall(report,'failed report'))\n            assert(__songlua_reporting_script_error==false)\n            root.ScriptErrorMessageCommand=function(self,p)log(p.message)end\n            lua=nil;collectgarbage()\n            assert(not pcall(report,false,'invalid arguments use no method receiver'))\n            report('retained report')\n         / a", FrameTexture { capture_name: "ActorFrameTexture 1", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("\n            local report=lua.ReportScriptError\n            root.ScriptErrorMessageCommand=function(self,p)\n                collectgarbage();log(p.message);report('nested error suppressed')\n            end\n            report('outer error')\n            assert(__songlua_reporting_script_error==false)\n            root.ScriptErrorMessageCommand=function()error('handler failure')end\n            assert(not pcall(report,'failed report'))\n            assert(__songlua_reporting_script_error==false)\n            root.ScriptErrorMessageCommand=function(self,p)log(p.message)end\n            lua=nil;collectgarbage()\n            assert(not pcall(report,false,'invalid arguments use no method receiver'))\n            report('retained report')\n         / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
