song/tests/rust_framebuffers.rs::payload
test: collecting_allocation_getters_preserve_partial_publication_and_retry
("a=root[1];b=root[2];sprite=root[3] / a", FrameTexture { capture_name: "ActorFrameTexture 1", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("a=root[1];b=root[2];sprite=root[3] / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("\n        local mt=getmetatable(a);local lookup=mt.__index\n        mt.__index=function(self,key)\n            if key=='__songlua_aft_alpha_buffer' then collectgarbage();b:aux(7);log('alpha');return true end\n            if key=='__songlua_aft_depth_buffer' then log('depth');error('flag failure') end\n            return lookup(self,key)\n        end\n        assert(not pcall(a.Create,a));assert(a:GetTexture()==nil);mt.__index=lookup;a:Create();texture(a:GetTexture())\n     / a", FrameTexture { capture_name: "ActorFrameTexture 1", capture_size: Some([1.0, 1.0]), alpha_buffer: false, depth_buffer: false, float_buffer: false })
("\n        local mt=getmetatable(a);local lookup=mt.__index\n        mt.__index=function(self,key)\n            if key=='__songlua_aft_alpha_buffer' then collectgarbage();b:aux(7);log('alpha');return true end\n            if key=='__songlua_aft_depth_buffer' then log('depth');error('flag failure') end\n            return lookup(self,key)\n        end\n        assert(not pcall(a.Create,a));assert(a:GetTexture()==nil);mt.__index=lookup;a:Create();texture(a:GetTexture())\n     / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
("local allocation=a.__songlua_aft_allocation;a.__songlua_aft_allocation=nil;local mt=getmetatable(a);local lookup=mt.__index;mt.__index=function(self,key) if key=='__songlua_aft_allocation' then collectgarbage();return allocation end;return lookup(self,key) end;assert(a:GetTexture()==nil);mt.__index=lookup;a.__songlua_aft_allocation=allocation / a", FrameTexture { capture_name: "ActorFrameTexture 1", capture_size: Some([1.0, 1.0]), alpha_buffer: false, depth_buffer: false, float_buffer: false })
("local allocation=a.__songlua_aft_allocation;a.__songlua_aft_allocation=nil;local mt=getmetatable(a);local lookup=mt.__index;mt.__index=function(self,key) if key=='__songlua_aft_allocation' then collectgarbage();return allocation end;return lookup(self,key) end;assert(a:GetTexture()==nil);mt.__index=lookup;a.__songlua_aft_allocation=allocation / b", FrameTexture { capture_name: "ActorFrameTexture 2", capture_size: None, alpha_buffer: false, depth_buffer: false, float_buffer: false })
