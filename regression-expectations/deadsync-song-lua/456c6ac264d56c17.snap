("\n            assert(SongMeterDisplay==nil and m.SetUpdateFunction~=nil)\n            assert(s:GetName()=='Stream' and s:GetParent()==m)\n            s:name('renamed');assert(m:GetChild('Stream')==s and m:GetChild('renamed')==nil)\n            local children=m:GetChildren();children.Stream=nil;assert(m:GetChild('Stream')==s)\n            m.__songlua_children.alias=s;assert(m:GetNumChildren()==2)\n            local f=m.SetStreamWidth;assert(f({},'25.5')==m and m:GetStreamWidth()==25.5)\n            local previous=ActorFrame.SetStreamWidth\n            ActorFrame.SetStreamWidth=function(self)assert(self==m);return 'override'end\n            assert(m:SetStreamWidth(99)=='override');ActorFrame.SetStreamWidth=previous\n            f(false);f('invalid');f();assert(m:GetStreamWidth()==25.5)\n            local saved=m.SetStreamWidth;m.__songlua_actor_type='Actor';saved(m,99)\n            m.__songlua_actor_type='SongMeterDisplay';assert(m:GetStreamWidth()==25.5)\n        ", Some(SongMeterDisplay { stream_width: 25.5, stream_state: SongLuaOverlayState { aux: 0.0, x: 0.0, y: 0.0, z: 0.0, z_bias: 0.0, draw_order: 0, draw_by_z_position: false, aft_created: false, aft_preserve: false, halign: 0.5, valign: 0.5, text_align: Center, uppercase: false, shadow_len: [0.0, 0.0], shadow_color: [0.0, 0.0, 0.0, 0.5], glow: [1.0, 1.0, 1.0, 0.0], fov: None, vanishpoint: None, diffuse: [1.0, 1.0, 1.0, 1.0], vertex_colors: None, visible: true, hibernating: false, cropleft: 0.0, cropright: 0.0, croptop: 0.0, cropbottom: 0.0, fadeleft: 0.0, faderight: 0.0, fadetop: 0.0, fadebottom: 0.0, mask_source: false, mask_dest: false, depth_test: false, depth_write: false, depth_test_on_fail: false, cull_mode: None, zoom: 1.0, zoom_x: 1.0, zoom_y: 1.0, zoom_z: 1.0, basezoom: 1.0, basezoom_x: 1.0, basezoom_y: 1.0, basezoom_z: 1.0, scale_factors: None, rot_x_deg: 0.0, rot_y_deg: 0.0, rot_z_deg: 0.0, base_rotation: [0.0, 0.0, 0.0], quaternion: [0.0, 0.0, 0.0, 1.0], base_alpha: 1.0, skew_x: 0.0, skew_y: 0.0, 