test: proxy_actor_identity_resolves_within_each_layer_and_duplicate_bindings_use_the_last_target
("bindings", [("1/5", Root(5)), ("1/4", Root(4))])
("bindings", [("1/5", Background(0, 5)), ("1/4", Background(0, 4))])
("bindings", [("1/5", Foreground(1, 5)), ("1/4", Foreground(1, 4))])
("bindings", [("1/5", Background(0, 5)), ("1/4", Foreground(0, 4))])
("bindings", [("1/5", Foreground(1, 5)), ("1/4", Foreground(0, 4))])
("bindings", [("1/5", Root(5)), ("1/4", Root(4)), ("1/4", Background(1, 4))])
("bindings", [("1", Root(0)), ("1/1", Root(1)), ("1/2", Root(2)), ("1/3", Root(3)), ("1/4", Root(4)), ("1/5", Root(5)), ("ScreenGameplay", Root(6))])
