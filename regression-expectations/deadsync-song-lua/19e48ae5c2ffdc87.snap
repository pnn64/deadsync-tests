test: failed_stage_or_player_queries_publish_fallback_and_keep_prior_mutations
("construction", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 54, 49, 48, 124, 54, 52, 124, 76, 105, 110, 101])
("\n        stage=setmetatable({}, {__index=function()collectgarbage('collect');error('stage')end})\n        player=setmetatable({}, {__index=function(self,key)\n            assert(key=='GetLifeRecord');collectgarbage('collect')\n            return function(self,seconds,count)\n                assert(self==player and seconds==0 and count==100)\n                g:x(17);collectgarbage('collect');return {[1]=.1,[100]=.9}\n            end\n        end})\n        g:Set(stage,player);assert(g:GetX()==17)\n    ", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 54, 49, 48, 124, 54, 52, 124, 76, 105, 110, 101])
("player={};assert(g:Set({},player)==g);assert(g.__songlua_graph_display_player_stats==player);log(g:GetY())", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 54, 49, 48, 124, 54, 52, 124, 76, 105, 110, 101, 124, 48])
("player={GetLifeRecord=false};assert(g:Set({},player)==g);assert(g.__songlua_graph_display_player_stats==player);log(g:GetY())", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 54, 49, 48, 124, 54, 52, 124, 76, 105, 110, 101, 124, 48, 124, 48])
("player={GetLifeRecord=setmetatable({},{__call=function()error('not a function')end})};assert(g:Set({},player)==g);assert(g.__songlua_graph_display_player_stats==player);log(g:GetY())", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 54, 49, 48, 124, 54, 52, 124, 76, 105, 110, 101, 124, 48, 124, 48, 124, 48])
("player={GetLifeRecord=function()g:y(13);error('record error')end};assert(g:Set({},player)==g);assert(g.__songlua_graph_display_player_stats==player);log(g:GetY())", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 54, 49, 48, 124, 54, 52, 124, 76, 105, 110, 101, 124, 48, 124, 48, 124, 48, 124, 49, 51])
("player={GetLifeRecord=function()return false end};assert(g:Set({},player)==g);assert(g.__songlua_graph_display_player_stats==player);log(g:GetY())", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 54, 49, 48, 124, 54, 52, 124, 76, 105, 110, 101, 124, 48, 124, 48, 124, 48, 124, 49, 51, 124, 49, 51])
("\n        local old=g.__songlua_graph_display_values\n        local set=g.Set\n        g.__songlua_actor_type='Actor';assert(set(g,{}, {})==g and g.__songlua_graph_display_values==old)\n        g.__songlua_actor_type='GraphDisplay'\n        g:Load('saved');g:Set(false,false);assert(g.__songlua_graph_display_stage_stats==false)\n        assert(#g.__songlua_graph_display_values==100)\n    ", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 54, 49, 48, 124, 54, 52, 124, 76, 105, 110, 101, 124, 48, 124, 48, 124, 48, 124, 49, 51, 124, 49, 51])
test: graph_snapshots_and_retained_callbacks_survive_collection_and_retirement
("construction", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 54, 49, 48, 124, 54, 52, 124, 76, 105, 110, 101])
("\n        weak=setmetatable({}, {__mode='v'})\n        g:Set({}, {GetLifeRecord=function()\n            local values={[1]=.25};weak[1]=values;collectgarbage('collect');return values\n        end})\n        retained=g.Set;collectgarbage('collect');assert(weak[1]~=nil)\n        line:diffuse({.2,.3,.4,.5});body[2]:visible(false)\n    ", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 54, 49, 48, 124, 54, 52, 124, 76, 105, 110, 101])
test: named_child_aliases_groups_and_read_errors_recover
("construction", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 51, 48, 48, 124, 54, 52, 124, 76, 105, 110, 101])
("\n        body[1]:x(3);body[2]:x(7);line:x(11)\n        children=g:GetChildren();assert(children[''][1]==body[1] and children.Line==line and children.authored==authored)\n        children[''][1]=line;assert(g:GetChild('')[1]==body[1])\n        g.__songlua_children.alias=line;assert(g:GetChild('alias')==line and g:GetNumChildren()==4)\n        g.__songlua_children['']=nil;assert(g:GetChild('')==nil)\n    ", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 51, 48, 48, 124, 54, 52, 124, 76, 105, 110, 101])
("g.__songlua_children['']=body;g.__songlua_children.Line=nil", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 51, 48, 48, 124, 54, 52, 124, 76, 105, 110, 101])
