test: native_child_message_subscriptions_precede_ordinary_scene_registration
("construction", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 51, 48, 48, 124, 54, 52, 124, 76, 105, 110, 101])
("\n        for i,a in ipairs{root,g,body[1],body[2],line,authored} do\n            local label=i\n            local mt={};for k,v in pairs(getmetatable(a)) do mt[k]=v end\n            local index=mt.__index\n            mt.__index=function(self,key)\n                if key=='ScanMessageCommand' then log('scan',label) end\n                if type(index)=='function' then return index(self,key) end\n                return index and index[key]\n            end\n            setmetatable(a,mt)\n        end\n        MESSAGEMAN:Broadcast('Scan')\n    ", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 51, 48, 48, 124, 54, 52, 124, 76, 105, 110, 101, 124, 115, 99, 97, 110, 124, 51, 124, 115, 99, 97, 110, 124, 52, 124, 115, 99, 97, 110, 124, 53, 124, 115, 99, 97, 110, 124, 49, 124, 115, 99, 97, 110, 124, 50, 124, 115, 99, 97, 110, 124, 54])
("\n        for i,a in ipairs{root,g,body[1],body[2],line,authored} do\n            local index=i\n            a:addcommand('ProbeMessage',function(self) log('message',index) end)\n        end\n        MESSAGEMAN:Broadcast('Probe');collectgarbage('collect');MESSAGEMAN:Broadcast('Probe')\n    ", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 51, 48, 48, 124, 54, 52, 124, 76, 105, 110, 101, 124, 115, 99, 97, 110, 124, 51, 124, 115, 99, 97, 110, 124, 52, 124, 115, 99, 97, 110, 124, 53, 124, 115, 99, 97, 110, 124, 49, 124, 115, 99, 97, 110, 124, 50, 124, 115, 99, 97, 110, 124, 54, 124, 109, 101, 115, 115, 97, 103, 101, 124, 49, 124, 109, 101, 115, 115, 97, 103, 101, 124, 53, 124, 109, 101, 115, 115, 97, 103, 101, 124, 50, 124, 109, 101, 115, 115, 97, 103, 101, 124, 52, 124, 109, 101, 115, 115, 97, 103, 101, 124, 54, 124, 109, 101, 115, 115, 97, 103, 101, 124, 51, 124, 109, 101, 115, 115, 97, 103, 101, 124, 49, 124, 109, 101, 115, 115, 97, 103, 101, 124, 53, 124, 109, 101, 115, 115, 97, 103, 101, 124, 50, 124, 109, 101, 115, 115, 97, 103, 101, 124, 52, 124, 109, 101, 115, 115, 97, 103, 101, 124, 54, 124, 109, 101, 115, 115, 97, 103, 101, 124, 51])
test: set_retains_stats_calls_life_record_and_normalizes_owned_samples
("construction", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 51, 48, 48, 124, 54, 52, 124, 76, 105, 110, 101])
("\n            stage={__songlua_total_steps_seconds='0x20'}\n            player={GetLifeRecord=function(self,seconds,count)\n                assert(self==player and seconds==32 and count==100)\n                assert(g.__songlua_graph_display_set and g.__songlua_graph_display_stage_stats==stage and g.__songlua_graph_display_player_stats==player)\n                collectgarbage('collect');g:Load('reentrant')\n                record={-1,2,'0.75',false,'nan','inf','-inf','0x10',0/0,math.huge,1e100}\n                return record,'ignored'\n            end}\n            assert(g:Set(stage,player)==g)\n            assert(g.__songlua_graph_display_values==record and g.__songlua_graph_display_metric=='reentrant')\n        ", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 51, 48, 48, 124, 54, 52, 124, 76, 105, 110, 101])
("record[1]=.25;record[2]=.125;collectgarbage('collect')", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 51, 48, 48, 124, 54, 52, 124, 76, 105, 110, 101])
("local f=g.Set;assert(f({},stage,player)==g);g:Set();assert(g.__songlua_graph_display_stage_stats==stage and g.__songlua_graph_display_player_stats==player)", [105, 110, 105, 116, 124, 124, 103, 114, 97, 112, 104, 32, 105, 110, 105, 116, 124, 50, 124, 52, 124, 51, 48, 48, 124, 54, 52, 124, 76, 105, 110, 101])
