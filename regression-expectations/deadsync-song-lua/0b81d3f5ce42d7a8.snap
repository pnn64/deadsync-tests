("rolling=root[1];bpm=root[2];devices=root[3];inputs=root[4]", "devices", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "No input devices", stroke_color: None, attributes: [] })
("rolling=root[1];bpm=root[2];devices=root[3];inputs=root[4]", "inputs", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "No unmapped inputs", stroke_color: None, attributes: [] })
("\n            assert(RollingNumbers==nil and BPMDisplay==nil and DeviceList==nil and InputList==nil)\n            assert(rolling:GetText()=='start' and bpm:GetText()=='')\n            assert(devices:GetText()=='No input devices' and inputs:GetText()=='No unmapped inputs')\n            for _,a in ipairs{rolling,bpm,devices,inputs} do\n                assert(a.GetText~=nil and a.SetUpdateFunction==nil and a.SetDrawFunction==nil and a.GetDrawFunction==nil)\n                assert(a.PixelFont==nil and a.NoStroke==nil and a.UnknownMethod==nil)\n                assert(a:GetTargetNumber()==0)\n                a:settext('text'):AddAttribute(0,{Length=-1,Diffuse={.1,.2,.3,.4}}):strokecolor({.4,.3,.2,.1})\n            end\n            assert(rolling:Load('RollingNumbersEvaluationA')==rolling)\n            assert(rolling:targetnumber(12)==rolling and rolling:GetText()=='0012' and rolling:GetTargetNumber()==12)\n            rolling:Load('RollingNumbersEvaluationB');assert(rolling:GetText()=='0012')\n            rolling:SetTargetNumber(7);assert(rolling:GetText()=='007')\n        ", "rolling", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "007", stroke_color: Some([0.4, 0.3, 0.2, 0.1]), attributes: [TextAttribute { start: 0, length: 18446744073709551615, color: [0.1, 0.2, 0.3, 0.4], vertex_colors: None, glow: None }] })
("\n            assert(RollingNumbers==nil and BPMDisplay==nil and DeviceList==nil and InputList==nil)\n            assert(rolling:GetText()=='start' and bpm:GetText()=='')\n            assert(devices:GetText()=='No input devices' and inputs:GetText()=='No unmapped inputs')\n            for _,a in ipairs{rolling,bpm,devices,inputs} do\n                assert(a.GetText~=nil and a.SetUpdateFunction==nil and a.SetDrawFunction==nil and a.GetDrawFunction==nil)\n                assert(a.PixelFont==nil and a.NoStroke==nil and a.UnknownMethod==nil)\n                assert(a:GetTargetNumber()==0)\n                a:settext('text'):AddAttribute(0,{Length=-1,Diffuse={.1,.2,.3,.4}}):strokecolor({.4,.3,.2,.1})\n            end\n            assert(rolling:Load('RollingNumbersEvaluationA')==rolling)\n            assert(rolling:targetnumber(12)==rolling and rolling:GetText()=='0012' and rolling:GetTargetNumber()==12)\n            rolling:Load('RollingNumbersEvaluationB');assert(rolling:GetText()=='0012')\n            rolling:SetTargetNumber(7);assert(rolling:GetText()=='007')\n        ", "bpm", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "text", stroke_color: Some([0.4, 0.3, 0.2, 0.1]), attributes: [TextAttribute { start: 0, length: 18446744073709551615, color: [0.1, 0.2, 0.3, 0.4], vertex_colors: None, glow: None }] })
("\n            assert(RollingNumbers==nil and BPMDisplay==nil and DeviceList==nil and InputList==nil)\n            assert(rolling:GetText()=='start' and bpm:GetText()=='')\n            assert(devices:GetText()=='No input devices' and inputs:GetText()=='No unmapped inputs')\n            for _,a in ipairs{rolling,bpm,devices,inputs} do\n                assert(a.GetText~=nil and a.SetUpdateFunction==nil and a.SetDrawFunction==nil and a.GetDrawFunction==nil)\n                assert(a.PixelFont==nil and a.NoStroke==nil and a.UnknownMethod==nil)\n                assert(a:GetTargetNumber()==0)\n                a:settext('text'):AddAttribute(0,{Length=-1,Diffuse={.1,.2,.3,.4}}):strokecolor({.4,.3,.2,.1})\n            end\n            assert(rolling:Load('RollingNumbersEvaluationA')==rolling)\n            assert(rolling:targetnumber(12)==rolling and rolling:GetText()=='0012' and rolling:GetTargetNumber()==12)\n            rolling:Load('RollingNumbersEvaluationB');assert(rolling:GetText()=='0012')\n            rolling:SetTargetNumber(7);assert(rolling:GetText()=='007')\n        ", "devices", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "No input devices", stroke_color: None, attributes: [] })
("\n            assert(RollingNumbers==nil and BPMDisplay==nil and DeviceList==nil and InputList==nil)\n            assert(rolling:GetText()=='start' and bpm:GetText()=='')\n            assert(devices:GetText()=='No input devices' and inputs:GetText()=='No unmapped inputs')\n            for _,a in ipairs{rolling,bpm,devices,inputs} do\n                assert(a.GetText~=nil and a.SetUpdateFunction==nil and a.SetDrawFunction==nil and a.GetDrawFunction==nil)\n                assert(a.PixelFont==nil and a.NoStroke==nil and a.UnknownMethod==nil)\n                assert(a:GetTargetNumber()==0)\n                a:settext('text'):AddAttribute(0,{Length=-1,Diffuse={.1,.2,.3,.4}}):strokecolor({.4,.3,.2,.1})\n            end\n            assert(rolling:Load('RollingNumbersEvaluationA')==rolling)\n            assert(rolling:targetnumber(12)==rolling and rolling:GetText()=='0012' and rolling:GetTargetNumber()==12)\n            rolling:Load('RollingNumbersEvaluationB');assert(rolling:GetText()=='0012')\n            rolling:SetTargetNumber(7);assert(rolling:GetText()=='007')\n        ", "inputs", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "No unmapped inputs", stroke_color: None, attributes: [] })
