test: load_keeps_rolling_metrics_separate_from_other_display_textures
("rolling=root[1];bpm=root[2];devices=root[3];inputs=root[4]", "rolling", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "start", stroke_color: None, attributes: [] })
("rolling=root[1];bpm=root[2];devices=root[3];inputs=root[4]", "bpm", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "", stroke_color: None, attributes: [] })
("rolling=root[1];bpm=root[2];devices=root[3];inputs=root[4]", "devices", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "No input devices", stroke_color: None, attributes: [] })
("rolling=root[1];bpm=root[2];devices=root[3];inputs=root[4]", "inputs", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "No unmapped inputs", stroke_color: None, attributes: [] })
("\n        path=\"$FIXTURE0/display.png\"\n        assert(bpm:Load(path)==bpm);assert(bpm:GetWidth()==12 and bpm:GetHeight()==8)\n        assert(devices:Load(path)==devices);assert(inputs:Load(path)==inputs)\n        assert(rolling:Load(path)==rolling);assert(rolling.Texture==nil)\n        rolling:targetnumber(12);assert(rolling:GetText()=='12')\n        local load=bpm.Load;load(inputs,nil);assert(bpm.Texture==nil and inputs.Texture==path)\n        bpm:Load(path);bpm.__songlua_actor_type='RollingNumbers'\n        bpm:Load('RollingNumbersEvaluationA'):targetnumber(3)\n        assert(bpm.Texture==path and bpm:GetText()=='0003')\n        bpm.__songlua_actor_type='BPMDisplay'\n        devices:Load(nil);inputs:Load(nil)\n    ", "rolling", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "12", stroke_color: None, attributes: [] })
("\n        path=\"$FIXTURE0/display.png\"\n        assert(bpm:Load(path)==bpm);assert(bpm:GetWidth()==12 and bpm:GetHeight()==8)\n        assert(devices:Load(path)==devices);assert(inputs:Load(path)==inputs)\n        assert(rolling:Load(path)==rolling);assert(rolling.Texture==nil)\n        rolling:targetnumber(12);assert(rolling:GetText()=='12')\n        local load=bpm.Load;load(inputs,nil);assert(bpm.Texture==nil and inputs.Texture==path)\n        bpm:Load(path);bpm.__songlua_actor_type='RollingNumbers'\n        bpm:Load('RollingNumbersEvaluationA'):targetnumber(3)\n        assert(bpm.Texture==path and bpm:GetText()=='0003')\n        bpm.__songlua_actor_type='BPMDisplay'\n        devices:Load(nil);inputs:Load(nil)\n    ", "bpm", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "0003", stroke_color: None, attributes: [] })
("\n        path=\"$FIXTURE0/display.png\"\n        assert(bpm:Load(path)==bpm);assert(bpm:GetWidth()==12 and bpm:GetHeight()==8)\n        assert(devices:Load(path)==devices);assert(inputs:Load(path)==inputs)\n        assert(rolling:Load(path)==rolling);assert(rolling.Texture==nil)\n        rolling:targetnumber(12);assert(rolling:GetText()=='12')\n        local load=bpm.Load;load(inputs,nil);assert(bpm.Texture==nil and inputs.Texture==path)\n        bpm:Load(path);bpm.__songlua_actor_type='RollingNumbers'\n        bpm:Load('RollingNumbersEvaluationA'):targetnumber(3)\n        assert(bpm.Texture==path and bpm:GetText()=='0003')\n        bpm.__songlua_actor_type='BPMDisplay'\n        devices:Load(nil);inputs:Load(nil)\n    ", "devices", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "No input devices", stroke_color: None, attributes: [] })
("\n        path=\"$FIXTURE0/display.png\"\n        assert(bpm:Load(path)==bpm);assert(bpm:GetWidth()==12 and bpm:GetHeight()==8)\n        assert(devices:Load(path)==devices);assert(inputs:Load(path)==inputs)\n        assert(rolling:Load(path)==rolling);assert(rolling.Texture==nil)\n        rolling:targetnumber(12);assert(rolling:GetText()=='12')\n        local load=bpm.Load;load(inputs,nil);assert(bpm.Texture==nil and inputs.Texture==path)\n        bpm:Load(path);bpm.__songlua_actor_type='RollingNumbers'\n        bpm:Load('RollingNumbersEvaluationA'):targetnumber(3)\n        assert(bpm.Texture==path and bpm:GetText()=='0003')\n        bpm.__songlua_actor_type='BPMDisplay'\n        devices:Load(nil);inputs:Load(nil)\n    ", "inputs", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "No unmapped inputs", stroke_color: None, attributes: [] })
test: status_resources_keep_fixed_labels_and_ignore_authored_style_payloads
("rolling=root[1];bpm=root[2];devices=root[3];inputs=root[4]", "rolling", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "start", stroke_color: None, attributes: [] })
("rolling=root[1];bpm=root[2];devices=root[3];inputs=root[4]", "bpm", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "", stroke_color: None, attributes: [] })
("rolling=root[1];bpm=root[2];devices=root[3];inputs=root[4]", "devices", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "No input devices", stroke_color: None, attributes: [] })
