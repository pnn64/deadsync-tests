("\n        rolling.__songlua_rolling_numbers_format=false;local old=rolling:GetText()\n        assert(not pcall(rolling.targetnumber,rolling,23));assert(rolling:GetTargetNumber()==23 and rolling:GetText()==old)\n        rolling.__songlua_rolling_numbers_format=nil\n        local mt=getmetatable(rolling);local oldindex=mt.__index\n        mt.__index=function(self,key)\n            if key=='__songlua_rolling_numbers_format' then collectgarbage();bpm:x(12);log('format read');return '%03.0f' end\n            return oldindex(self,key)\n        end\n        rolling:targetnumber(3);assert(rolling:GetText()=='003');mt.__index=oldindex\n        rolling.__songlua_target_number='0x20';assert(rolling:GetTargetNumber()==32)\n        rolling.__songlua_target_number=false;assert(not pcall(rolling.GetTargetNumber,rolling))\n        rolling.__songlua_target_number=nil;assert(rolling:GetTargetNumber()==0)\n    ", "rolling", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "003", stroke_color: None, attributes: [] })
("\n        rolling.__songlua_rolling_numbers_format=false;local old=rolling:GetText()\n        assert(not pcall(rolling.targetnumber,rolling,23));assert(rolling:GetTargetNumber()==23 and rolling:GetText()==old)\n        rolling.__songlua_rolling_numbers_format=nil\n        local mt=getmetatable(rolling);local oldindex=mt.__index\n        mt.__index=function(self,key)\n            if key=='__songlua_rolling_numbers_format' then collectgarbage();bpm:x(12);log('format read');return '%03.0f' end\n            return oldindex(self,key)\n        end\n        rolling:targetnumber(3);assert(rolling:GetText()=='003');mt.__index=oldindex\n        rolling.__songlua_target_number='0x20';assert(rolling:GetTargetNumber()==32)\n        rolling.__songlua_target_number=false;assert(not pcall(rolling.GetTargetNumber,rolling))\n        rolling.__songlua_target_number=nil;assert(rolling:GetTargetNumber()==0)\n    ", "bpm", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "", stroke_color: None, attributes: [] })
("\n        rolling.__songlua_rolling_numbers_format=false;local old=rolling:GetText()\n        assert(not pcall(rolling.targetnumber,rolling,23));assert(rolling:GetTargetNumber()==23 and rolling:GetText()==old)\n        rolling.__songlua_rolling_numbers_format=nil\n        local mt=getmetatable(rolling);local oldindex=mt.__index\n        mt.__index=function(self,key)\n            if key=='__songlua_rolling_numbers_format' then collectgarbage();bpm:x(12);log('format read');return '%03.0f' end\n            return oldindex(self,key)\n        end\n        rolling:targetnumber(3);assert(rolling:GetText()=='003');mt.__index=oldindex\n        rolling.__songlua_target_number='0x20';assert(rolling:GetTargetNumber()==32)\n        rolling.__songlua_target_number=false;assert(not pcall(rolling.GetTargetNumber,rolling))\n        rolling.__songlua_target_number=nil;assert(rolling:GetTargetNumber()==0)\n    ", "devices", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "No input devices", stroke_color: None, attributes: [] })
("\n        rolling.__songlua_rolling_numbers_format=false;local old=rolling:GetText()\n        assert(not pcall(rolling.targetnumber,rolling,23));assert(rolling:GetTargetNumber()==23 and rolling:GetText()==old)\n        rolling.__songlua_rolling_numbers_format=nil\n        local mt=getmetatable(rolling);local oldindex=mt.__index\n        mt.__index=function(self,key)\n            if key=='__songlua_rolling_numbers_format' then collectgarbage();bpm:x(12);log('format read');return '%03.0f' end\n            return oldindex(self,key)\n        end\n        rolling:targetnumber(3);assert(rolling:GetText()=='003');mt.__index=oldindex\n        rolling.__songlua_target_number='0x20';assert(rolling:GetTargetNumber()==32)\n        rolling.__songlua_target_number=false;assert(not pcall(rolling.GetTargetNumber,rolling))\n        rolling.__songlua_target_number=nil;assert(rolling:GetTargetNumber()==0)\n    ", "inputs", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "No unmapped inputs", stroke_color: None, attributes: [] })
test: text_layout_for_unlinked_displays_uses_generic_fit_geometry
("rolling=root[1];bpm=root[2];devices=root[3];inputs=root[4]", "rolling", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "start", stroke_color: None, attributes: [] })
("rolling=root[1];bpm=root[2];devices=root[3];inputs=root[4]", "bpm", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "", stroke_color: None, attributes: [] })
("rolling=root[1];bpm=root[2];devices=root[3];inputs=root[4]", "devices", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "No input devices", stroke_color: None, attributes: [] })
("rolling=root[1];bpm=root[2];devices=root[3];inputs=root[4]", "inputs", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "No unmapped inputs", stroke_color: None, attributes: [] })
("for _,a in ipairs{rolling,bpm,devices,inputs} do a:settext('words'):maxwidth(90):maxheight(80):zoom(2):wrapwidthpixels(35):vertspacing(-3):uppercase(true):jitter(true):rainbowscroll(true) end", "rolling", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "words", stroke_color: None, attributes: [] })
("for _,a in ipairs{rolling,bpm,devices,inputs} do a:settext('words'):maxwidth(90):maxheight(80):zoom(2):wrapwidthpixels(35):vertspacing(-3):uppercase(true):jitter(true):rainbowscroll(true) end", "bpm", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "words", stroke_color: None, attributes: [] })
("for _,a in ipairs{rolling,bpm,devices,inputs} do a:settext('words'):maxwidth(90):maxheight(80):zoom(2):wrapwidthpixels(35):vertspacing(-3):uppercase(true):jitter(true):rainbowscroll(true) end", "devices", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "No input devices", stroke_color: None, attributes: [] })
