("\n        a:SetStateProperties{{Frame=0,Delay=.2},{Frame=1,Delay=.4}}\n        assert(a:loop(false):rate('1.5'):position(.3)==a);log(a:GetState())\n        a:position(false):rate({}):loop({});log(a:GetState())\n        h=a:GetTexture();metadata(h)\n        root:SetUpdateFunction(function(self,dt)\n            count=(count or 0)+1;collectgarbage('collect')\n            if count==1 then a:LoadFromSong({HasBanner=function()return true end,GetBannerPath=function()return second end})\n            elseif count==2 then a:Load(first)\n            else a:position(.4):rate(2):loop(false) end\n            log(a:GetWidth(),a:GetHeight(),a:GetState());metadata(a:GetTexture());metadata(h)\n        end)\n    ", [SongLuaOverlayState { aux: 0.0, x: 0.0, y: 0.0, z: 0.0, z_bias: 0.0, draw_order: 0, draw_by_z_position: false, aft_created: false, aft_preserve: false, halign: 0.5, valign: 0.5, text_align: Center, uppercase: false, shadow_len: [0.0, 0.0], shadow_color: [0.0, 0.0, 0.0, 0.5], glow: [1.0, 1.0, 1.0, 0.0], fov: None, vanishpoint: None, diffuse: [1.0, 1.0, 1.0, 1.0], vertex_colors: None, visible: true, hibernating: false, cropleft: 0.0, cropright: 0.0, croptop: 0.0, cropbottom: 0.0, fadeleft: 0.0, faderight: 0.0, fadetop: 0.0, fadebottom: 0.0, mask_source: false, mask_dest: false, depth_test: false, depth_write: false, depth_test_on_fail: false, cull_mode: None, zoom: 1.0, zoom_x: 1.0, zoom_y: 1.0, zoom_z: 1.0, basezoom: 1.0, basezoom_x: 1.0, basezoom_y: 1.0, basezoom_z: 1.0, scale_factors: None, rot_x_deg: 0.0, rot_y_deg: 0.0, rot_z_deg: 0.0, base_rotation: [0.0, 0.0, 0.0], quaternion: [0.0, 0.0, 0.0, 1.0], base_alpha: 1.0, skew_x: 0.0, skew_y: 0.0, blend: Alpha, vibrate: false, effect_magnitude: [0.0, 0.0, 0.0], inherited_vibrate: [0.0, 0.0, 0.0], effect_clock: Time, effect_timer: true, effect_no_offset: false, effect_mode: None, effect_color1: [1.0, 1.0, 1.0, 1.0], effect_color2: [1.0, 1.0, 1.0, 1.0], effect_period: 1.0, effect_offset: 0.0, effect_time: None, effect_timing