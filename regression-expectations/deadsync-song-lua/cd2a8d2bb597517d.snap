test: queued_immediate_capture_preserves_dispatch_precision_final_values_and_cancellation
[SongLuaStatefulMessageCapture { message: "Tint", overlay_targets: [(0, [ShadowColor])], writes: [SongLuaStatefulMessageWrite { overlay_index: 0, beat: 3.0, target: ShadowColor, value: Vec4([1.0, 0.5, 0.25, 1.0]), delay_seconds: 0.0, duration_seconds: 0.0, easing: None, opt1: None }] }]
[SongLuaStatefulMessageCapture { message: "Tint", overlay_targets: [(0, [ShadowColor])], writes: [SongLuaStatefulMessageWrite { overlay_index: 0, beat: 3.0, target: ShadowColor, value: Vec4([1.0, 0.5, 0.25, 1.0]), delay_seconds: 0.0, duration_seconds: 0.0, easing: None, opt1: None }] }]
