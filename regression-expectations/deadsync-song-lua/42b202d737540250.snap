test: native_fixture_inheritance_and_theme_helpers
("label=root[1];other=root[2]", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "initial", stroke_color: None, attributes: [] })
("label:settext('');native_label=label;assert(type(BitmapText.GetX)==\"function\")\nassert(native_label.GetChild==nil and native_label.SetUpdateFunction==nil and native_label.GetDrawFunction==nil)\nassert(native_label.UnknownNativeMethod==nil and BitmapText.UnknownNativeMethod==nil)\nassert(native_label:GetText()==\"\")\nassert(native_label:x(13)==native_label and native_label:GetX()==13)\nassert(native_label:jitter(true)==native_label and native_label:jitter(false)==native_label)\nBitmapText.NativeAdded = function(self) return self:GetText() end\nassert(native_label:NativeAdded()==\"\")\nBitmapText.NativeAdded=nil\nlocal original=Actor.GetX\nActor.GetX=function() return 91 end\nlocal inherited=native_label:GetX()\nActor.GetX=original\nassert(inherited==91 and native_label:GetX()==13)\nassert(native_label:get_mult_attrs_with_diffuse()==false)\nassert(native_label:set_mult_attrs_with_diffuse(true)==native_label)\nassert(native_label:get_mult_attrs_with_diffuse()==true)\nassert(native_label:set_mult_attrs_with_diffuse(0)==native_label)\nassert(native_label:get_mult_attrs_with_diffuse()==true)\nassert(native_label:set_mult_attrs_with_diffuse(false)==native_label)\nassert(native_label:get_mult_attrs_with_diffuse()==false)\nassert(native_label:set_mult_attrs_with_diffuse(\"false\")==native_label)\nassert(native_label:get_mult_attrs_with_diffuse()==true)\nassert(native_label:set_mult_attrs_with_diffuse()==native_label)\nassert(native_label:get_mult_attrs_with_diffuse()==false)\nassert(native_label:set_mult_attrs_with_diffuse({})==native_label)\nassert(native_label:get_mult_attrs_with_diffuse()==true)\n", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "", stroke_color: None, attributes: [] })
("\n        assert(label:PixelFont()==label);label:Stroke({1,0,.5,.25});label:NoStroke()\n        label:DiffuseAndStroke({.5,.4,.3,.2},{.2,.3,.4,.5}):settextf('%04d %s',7,'text')\n        assert(label:GetText()=='0007 text')\n        local saved=color;color=function(s) log('color',s);return {.4,.3,.2,.1} end;label:NoStroke();color=saved\n        local saved=string.format;string.format=function(...) log('format');return 'override' end;label:settextf('anything');string.format=saved\n        assert(label:GetText()=='override')\n    ", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "override", stroke_color: Some([0.4, 0.3, 0.2, 0.1]), attributes: [] })
test: retained_text_updates_during_live_tweens_and_draw_callbacks
("label=root[1];other=root[2]", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "initial", stroke_color: None, attributes: [] })
("\n        label:linear(1):x(100):maxwidth(80):zoom(2):jitter(true):settext('queued pose')\n        root:SetUpdateFunction(function(self,delta)\n            collectgarbage();label:settextf('%.2f',delta):ClearAttributes():AddAttribute(0,{Length=-1,Diffuse={.2,.4,.6,.8}})\n        end)\n        root:SetDrawFunction(function(self)\n            label:settext(label:GetText()..' drawn');label:Draw()\n        end)\n    ", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "queued pose", stroke_color: None, attributes: [] })
("live update", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "0.25", stroke_color: None, attributes: [TextAttribute { start: 0, length: 18446744073709551615, color: [0.2, 0.4, 0.6, 0.8], vertex_colors: None, glow: None }] })
("draw callback", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "0.25 drawn", stroke_color: None, attributes: [TextAttribute { start: 0, length: 18446744073709551615, color: [0.2, 0.4, 0.6, 0.8], vertex_colors: None, glow: None }] })
("live update", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "0.50", stroke_color: None, attributes: [TextAttribute { start: 0, length: 18446744073709551615, color: [0.2, 0.4, 0.6, 0.8], vertex_colors: None, glow: None }] })
("draw callback", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "0.50 drawn", stroke_color: None, attributes: [TextAttribute { start: 0, length: 18446744073709551615, color: [0.2, 0.4, 0.6, 0.8], vertex_colors: None, glow: None }] })
("live update", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "0.50", stroke_color: None, attributes: [TextAttribute { start: 0, length: 18446744073709551615, color: [0.2, 0.4, 0.6, 0.8], vertex_colors: None, glow: None }] })
("draw callback", BitmapText { font: Some(("miso", "assets/fonts/miso/_miso light.ini")), text: "0.50 drawn", stroke_color: None, attributes: [TextAttribute { start: 0, length: 18446744073709551615, color: [0.2, 0.4, 0.6, 0.8], vertex_colors: None, glow: None }] })
