("assert(not pcall(a.GetTexture,a));allocation.size={4,5};texture(a:GetTexture())", [99, 104, 105, 108, 100, 32, 73, 110, 105, 116, 124, 114, 101, 115, 116, 111, 114, 101, 100, 124, 52, 124, 53, 124, 52, 124, 56, 124, 52, 124, 53, 124, 49, 47, 49])
test: texture_handle_equality_and_collection_keep_captured_metadata
("a=root[1];b=root[2];sprite=root[3]", [99, 104, 105, 108, 100, 32, 73, 110, 105, 116, 47, 48])
("a:Create();b:Create();local x=a:GetTexture();local y=a:GetTexture();assert(x==y,'same allocation');assert(x~=b:GetTexture(),'different allocations');saved=x;weak=setmetatable({y},{__mode='v'});y=nil;collectgarbage();collectgarbage();texture(saved)", [99, 104, 105, 108, 100, 32, 73, 110, 105, 116, 124, 65, 99, 116, 111, 114, 70, 114, 97, 109, 101, 84, 101, 120, 116, 117, 114, 101, 32, 49, 124, 49, 124, 49, 124, 49, 124, 49, 124, 49, 124, 49, 124, 49, 47, 50])
("a.__songlua_aft_allocation.name='changed';a.__songlua_aft_allocation.size={17,9};texture(saved);texture(a:GetTexture());assert(saved~=a:GetTexture());saved:loop(false):rate(2)", [99, 104, 105, 108, 100, 32, 73, 110, 105, 116, 124, 65, 99, 116, 111, 114, 70, 114, 97, 109, 101, 84, 101, 120, 116, 117, 114, 101, 32, 49, 124, 49, 124, 49, 124, 49, 124, 49, 124, 49, 124, 49, 124, 49, 124, 65, 99, 116, 111, 114, 70, 114, 97, 109, 101, 84, 101, 120, 116, 117, 114, 101, 32, 49, 124, 49, 124, 49, 124, 49, 124, 49, 124, 49, 124, 49, 124, 49, 124, 99, 104, 97, 110, 103, 101, 100, 124, 49, 55, 124, 57, 124, 51, 50, 124, 49, 54, 124, 49, 55, 124, 57, 124, 49, 47, 50])
