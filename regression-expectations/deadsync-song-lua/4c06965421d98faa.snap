song/tests/rust_meshes.rs::payload
test: copied_texture_handle_retains_identity_and_metadata_across_gc_and_reload
("construction / a", None)
("construction / b", None)
("\n        copied=a:GetTexture()\n        b:SetTexture(copied)\n        assert(b:GetTexture() == copied)\n        collectgarbage('collect')\n        log(b:GetTexture():GetPath(),b:GetTexture():GetTextureWidth(),b:GetTexture():GetTextureHeight())\n        a:LoadTexture(nil)\n        assert(b:GetTexture() == copied)\n        assert(a:GetTexture() ~= copied)\n        log(copied:GetNumFrames(),b:GetTexture():GetNumFrames())\n        b:LoadTexture(nil)\n        assert(b:GetTexture() ~= copied and b:GetTexture():GetPath() == '')\n        log(b:GetTexture():GetTextureWidth(),b:GetTexture():GetTextureHeight())\n         / a", None)
("\n        copied=a:GetTexture()\n        b:SetTexture(copied)\n        assert(b:GetTexture() == copied)\n        collectgarbage('collect')\n        log(b:GetTexture():GetPath(),b:GetTexture():GetTextureWidth(),b:GetTexture():GetTextureHeight())\n        a:LoadTexture(nil)\n        assert(b:GetTexture() == copied)\n        assert(a:GetTexture() ~= copied)\n        log(copied:GetNumFrames(),b:GetTexture():GetNumFrames())\n        b:LoadTexture(nil)\n        assert(b:GetTexture() ~= copied and b:GetTexture():GetPath() == '')\n        log(b:GetTexture():GetTextureWidth(),b:GetTexture():GetTextureHeight())\n         / b", None)
test: draw_state_getters_reenter_collect_and_keep_partial_writes
("construction / a", None)
("construction / b", None)
("\n        a:SetVertices(vertices)\n        local reads=0\n        a:SetDrawState(setmetatable({}, {__index=function(self,key)\n            b:aux(b:getaux()+1);collectgarbage('collect')\n            if key=='Mode' then reads=reads+1;return reads==1 and 'DrawMode_Quads' or 'DrawMode_Fan' end\n            return key=='First' and 2 or 4\n        end}));log(a:GetDestDrawMode(),a.__songlua_draw_state.Mode)\n        local original=a.__songlua_draw_state\n        assert(not pcall(a.SetDrawState,a,setmetatable({}, {__index=function(self,key)\n            collectgarbage('collect');if key=='Mode' then return 'DrawMode_Triangles' end;error('range failure')\n        end})))\n        assert(a.__songlua_draw_state==original);log(original.Mode,a:GetDestDrawMode())\n     / a", Some(ActorMesh { vertices: [SongLuaOverlayMeshVertex { pos: [10.0, 0.0], z: 2.0, color: [0.0, 1.0, 0.0, 0.75], uv: [1.0, 0.0] }, SongLuaOverlayMeshVertex { pos: [10.0, 10.0], z: 3.0, color: [0.0, 0.0, 1.0, 1.0], uv: [1.0, 1.0] }, SongLuaOverlayMeshVertex { pos: [0.0, 10.0], z: 4.0, color: [1.0, 1.0, 0.0, 1.0], uv: [0.0, 1.0] }, SongLuaOverlayMeshVertex { pos: [10.0, 0.0], z: 2.0, color: [0.0, 1.0, 0.0, 0.75], uv: [1.0, 0.0] }, SongLuaOverlayMeshVertex { pos: [0.0, 10.0], z: 4.0, color: [1.0, 1.0, 0.0, 1.0], uv: [0.0, 1.0] }, SongLuaOverlayMeshVertex { pos: [-5.0, 5.0], z: 5.0, color: [1.0, 0.0, 1.0, 1.0], uv: [0.5, 0.5] }], texture_path: Some("__songlua_native_default_texture.png") }))
("\n        a:SetVertices(vertices)\n        local reads=0\n        a:SetDrawState(setmetatable({}, {__index=function(self,key)\n            b:aux(b:getaux()+1);collectgarbage('collect')\n            if key=='Mode' then reads=reads+1;return reads==1 and 'DrawMode_Quads' or 'DrawMode_Fan' end\n            return key=='First' and 2 or 4\n        end}));log(a:GetDestDrawMode(),a.__songlua_draw_state.Mode)\n        local original=a.__songlua_draw_state\n        assert(not pcall(a.SetDrawState,a,setmetatable({}, {__index=function(self,key)\n            collectgarbage('collect');if key=='Mode' then return 'DrawMode_Triangles' end;error('range failure')\n        end})))\n        assert(a.__songlua_draw_state==original);log(original.Mode,a:GetDestDrawMode())\n     / b", None)
("a.__songlua_draw_state=setmetatable({}, {__index=function(self,key) b:aux(b:getaux()+1);collectgarbage('collect');error('ignored range failure') end}) / a", Some(ActorMesh { vertices: [SongLuaOverlayMeshVertex { pos: [0.0, 0.0], z: 1.0, color: [1.0, 0.0, 0.0, 0.5], uv: [0.0, 0.0] }, SongLuaOverlayMeshVertex { pos: [10.0, 0.0], z: 2.0, color: [0.0, 1.0, 0.0, 0.75], uv: [1.0, 0.0] }, SongLuaOverlayMeshVertex { pos: [10.0, 10.0], z: 3.0, color: [0.0, 0.0, 1.0, 1.0], uv: [1.0, 1.0] }, SongLuaOverlayMeshVertex { pos: [0.0, 0.0], z: 1.0, color: [1.0, 0.0, 0.0, 0.5], uv: [0.0, 0.0] }, SongLuaOverlayMeshVertex { pos: [10.0, 10.0], z: 3.0, color: [0.0, 0.0, 1.0, 1.0], uv: [1.0, 1.0] }, SongLuaOverlayMeshVertex { pos: [0.0, 10.0], z: 4.0, color: [1.0, 1.0, 0.0, 1.0], uv: [0.0, 1.0] }, SongLuaOverlayMeshVertex { pos: [0.0, 0.0], z: 1.0, color: [1.0, 0.0, 0.0, 0.5], uv: [0.0, 0.0] }, SongLuaOverlayMeshVertex { pos: [0.0, 10.0], z: 4.0, color: [1.0, 1.0, 0.0, 1.0], uv: [0.0, 1.0] }, SongLuaOverlayMeshVertex { pos: [-5.0, 5.0], z: 5.0, color: [1.0, 0.0, 1.0, 1.0], uv: [0.5, 0.5] }, SongLuaOverlayMeshVertex { pos: [0.0, 0.0], z: 1.0, color: [1.0, 0.0, 0.0, 0.5], uv: [0.0, 0.0] }, SongLuaOverlayMeshVertex { pos: [-5.0, 5.0], z: 5.0, color: [1.0, 0.0, 1.0, 1.0], uv: [0.5, 0.5] }, SongLuaOverlayMeshVertex { pos: [-5.0, -5.0], z: 6.0, color: [0.0, 1.0, 1.0, 1.0], uv: [0.5, 0.0] }], texture_path: Some("__songlua_native_default_texture.png") }))
("a.__songlua_draw_state=setmetatable({}, {__index=function(self,key) b:aux(b:getaux()+1);collectgarbage('collect');error('ignored range failure') end}) / b", None)
("a.__songlua_draw_state=nil;assert(not pcall(a.SetDrawState,a,{Mode=false,First=2}));assert(a.__songlua_draw_state.Mode==false);log(a:GetDestDrawMode()) / a", Some(ActorMesh { vertices: [SongLuaOverlayMeshVertex { pos: [10.0, 0.0], z: 2.0, color: [0.0, 1.0, 0.0, 0.75], uv: [1.0, 0.0] }, SongLuaOverlayMeshVertex { pos: [10.0, 10.0], z: 3.0, color: [0.0, 0.0, 1.0, 1.0], uv: [1.0, 1.0] }, SongLuaOverlayMeshVertex { pos: [0.0, 10.0], z: 4.0, color: [1.0, 1.0, 0.0, 1.0], uv: [0.0, 1.0] }, SongLuaOverlayMeshVertex { pos: [10.0, 0.0], z: 2.0, color: [0.0, 1.0, 0.0, 0.75], uv: [1.0, 0.0] }, SongLuaOverlayMeshVertex { pos: [0.0, 10.0], z: 4.0, color: [1.0, 1.0, 0.0, 1.0], uv: [0.0, 1.0] }, SongLuaOverlayMeshVertex { pos: [-5.0, 5.0], z: 5.0, color: [1.0, 0.0, 1.0, 1.0], uv: [0.5, 0.5] }, SongLuaOverlayMeshVertex { pos: [10.0, 0.0], z: 2.0, color: [0.0, 1.0, 0.0, 0.75], uv: [1.0, 0.0] }, SongLuaOverlayMeshVertex { pos: [-5.0, 5.0], z: 5.0, color: [1.0, 0.0, 1.0, 1.0], uv: [0.5, 0.5] }, SongLuaOverlayMeshVertex { pos: [-5.0, -5.0], z: 6.0, color: [0.0, 1.0, 1.0, 1.0], uv: [0.5, 0.0] }], texture_path: Some("__songlua_native_default_texture.png") }))
("a.__songlua_draw_state=nil;assert(not pcall(a.SetDrawState,a,{Mode=false,First=2}));assert(a.__songlua_draw_state.Mode==false);log(a:GetDestDrawMode()) / b", None)
("a.__songlua_draw_state=nil;a:SetDrawState{Mode='DrawMode_Triangles'};a.__songlua_vertices=nil;local mt=getmetatable(a);local lookup=mt.__index;mt.__index=function(self,key) if key=='__songlua_vertices' then collectgarbage('collect');return vertices end;return lookup(self,key) end / a", Some(ActorMesh { vertices: [SongLuaOverlayMeshVertex { pos: [0.0, 0.0], z: 1.0, color: [1.0, 0.0, 0.0, 0.5], uv: [0.0, 0.0] }, SongLuaOverlayMeshVertex { pos: [10.0, 0.0], z: 2.0, color: [0.0, 1.0, 0.0, 0.75], uv: [1.0, 0.0] }, SongLuaOverlayMeshVertex { pos: [10.0, 10.0], z: 3.0, color: [0.0, 0.0, 1.0, 1.0], uv: [1.0, 1.0] }, SongLuaOverlayMeshVertex { pos: [0.0, 10.0], z: 4.0, color: [1.0, 1.0, 0.0, 1.0], uv: [0.0, 1.0] }, SongLuaOverlayMeshVertex { pos: [-5.0, 5.0], z: 5.0, color: [1.0, 0.0, 1.0, 1.0], uv: [0.5, 0.5] }, SongLuaOverlayMeshVertex { pos: [-5.0, -5.0], z: 6.0, color: [0.0, 1.0, 1.0, 1.0], uv: [0.5, 0.0] }], texture_path: Some("__songlua_native_default_texture.png") }))
