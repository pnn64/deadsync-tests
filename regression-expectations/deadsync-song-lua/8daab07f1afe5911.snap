("\n        assert(m:GetNumChildren()==3 and a:GetParent()==m and b:GetParent()==m)\n        local group=m:GetChild('same');assert(group[1]==a and group[2]==b)\n        assert(m:GetChild('')==c and m:GetChild('missing')==nil)\n        assert(m:GetChildren().same[2]==b)\n        local bound=m.GetChild;assert(bound({},'')==c)\n        m.__songlua_children.alias=a\n        assert(m:GetChild('alias')==a and m:GetNumChildren()==3)\n        a:name('renamed');assert(m:GetChild('same')==b and m:GetChild('renamed')==a)\n        assert(m:GetChildren().alias==a)\n        collectgarbage('collect');log(m:GetNumChildren())\n    ", [SongLuaOverlayState { aux: 0.0, x: 0.0, y: 0.0, z: 0.0, z_bias: 0.0, draw_order: 0, draw_by_z_position: false, aft_created: false, aft_preserve: false, halign: 0.5, valign: 0.5, text_align: Center, uppercase: false, shadow_len: [0.0, 0.0], shadow_color: [0.0, 0.0, 0.0, 0.5], glow: [1.0, 1.0, 1.0, 0.0], fov: None, vanishpoint: None, diffuse: [1.0, 1.0, 1.0, 1.0], vertex_colors: None, visible: true, hibernating: false, cropleft: 0.0, cropright: 0.0, croptop: 0.0, cropbottom: 0.0, fadeleft: 0.0, faderight: 0.0, fadetop: 0.0, fadebottom: 0.0, mask_source: false, mask_dest: false, depth_test: true, depth_write: true, depth_test_on_fail: false, cull_mode: Back, zoom: 1.0, zoom_x: 1.0, zoom_y: 1.0, zoom_z: 1.0, basezoom: 1.0, basezoom_x: 1.0, basezoom_y: 1.0, basezoom_z: 1.0, scale_factors: None, rot_x_deg: 0.0, rot_y_deg: 0.0, rot_z_deg: 0.0, base_rotation: [0.0, 0.0, 0.0], quaternion: [0.0, 0.0, 0.0, 1.0], base_alpha: 1.0, skew_x: 0.0, skew_y: 0.0, blend: Alpha, vibrate: false, effect_magnitude: [0.0, 0.0, 0.0], inherited_vibrate: [0.0, 0.0, 0.0], effect_clock: Time, effect_timer: true, effect_no_offset: false, effect_mode: None, effect_color1: [1.0, 1.0, 1.0, 1.0], effect_color2: [1.0, 1.0, 1.0, 1.0], effect_period: 1.0, effect_offset: 0.0, effect_time: None, effect_timing: None, rainbow: false, rainbow_scroll: false, text_jitter: false, text_distortion: 0