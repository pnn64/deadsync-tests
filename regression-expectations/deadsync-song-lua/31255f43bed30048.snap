test: frozen_native_proxy_inventory_identity_and_inheritance
("p=root[1];a=root[2];q=root[3]", [])
("native_proxy=p;native_target=a", [])
("local function check_proxy(proxy, target)\n    assert(type(ActorProxy) == \"table\", \"ActorProxy public class exists\")\n    assert(type(ActorProxy.GetX) == \"function\", \"ActorProxy inherits Actor\")\n    assert(type(ActorProxy.SetTarget) == \"function\" and type(ActorProxy.GetTarget) == \"function\")\n    assert(proxy.GetChild == nil and proxy.SetUpdateFunction == nil and proxy.GetDrawFunction == nil)\n    assert(proxy.UnknownNativeMethod == nil and ActorProxy.UnknownNativeMethod == nil)\n    assert(proxy:GetTarget() == nil, \"unassigned target is nil\")\n    assert(proxy:SetTarget(target) == proxy and proxy:GetTarget() == target, \"target identity\")\n    assert(not pcall(function() proxy:SetTarget() end), \"missing target is invalid\")\n    for _, value in ipairs({false, 0, \"actor\", {}}) do\n        assert(not pcall(function() proxy:SetTarget(value) end), \"target must be an Actor\")\n        assert(proxy:GetTarget() == target, \"invalid target leaves previous target intact\")\n    end\n    proxy:x(13)\n    target:x(7)\n    assert(proxy:GetX() == 13 and target:GetX() == 7, \"proxy position is independent\")\n    ActorProxy.ProxyAddedMethod = function(self) return self:GetTarget() end\n    assert(proxy:ProxyAddedMethod() == target, \"live class methods\")\n    ActorProxy.ProxyAddedMethod = nil\n    local original = Actor.GetX\n    Actor.GetX = function() return 91 end\n    local inherited = proxy:GetX()\n    Actor.GetX = original\n    assert(inherited == 91 and proxy:GetX() == 13, \"live base overrides\")\nend\n\nif native_proxy then\n    local own = {}\n    for name, method in pairs(ActorProxy) do\n        if type(method) == \"function\" then own[name] = true end\n    end\n    assert(own.SetTarget and own.GetTarget)\n    own.SetTarget, own.GetTarget = nil, nil\n    assert(next(own) == nil, \"exact native own method inventory\")\n    check_proxy(native_proxy, native_target)\nelse\n    return Def.ActorFrame{\n        OnCommand = function(self) check_proxy(self:GetChild(\"Proxy\"), self:GetChild(\"Target\")) end,\n        Def.ActorProxy{Name = \"Proxy\"},\n        Def.Actor{Name = \"Target\"},\n    }\nend\n", [])
("p=root[1];a=root[2];q=root[3]", [])
("native_proxy=p;native_target=a", [])
("local function check_proxy(proxy, target)\n    assert(type(ActorProxy) == \"table\", \"ActorProxy public class exists\")\n    assert(type(ActorProxy.GetX) == \"function\", \"ActorProxy inherits Actor\")\n    assert(type(ActorProxy.SetTarget) == \"function\" and type(ActorProxy.GetTarget) == \"function\")\n    assert(proxy.GetChild == nil and proxy.SetUpdateFunction == nil and proxy.GetDrawFunction == nil)\n    assert(proxy.UnknownNativeMethod == nil and ActorProxy.UnknownNativeMethod == nil)\n    assert(proxy:GetTarget() == nil, \"unassigned target is nil\")\n    assert(proxy:SetTarget(target) == proxy and proxy:GetTarget() == target, \"target identity\")\n    assert(not pcall(function() proxy:SetTarget() end), \"missing target is invalid\")\n    for _, value in ipairs({false, 0, \"actor\", {}}) do\n        assert(not pcall(function() proxy:SetTarget(value) end), \"target must be an Actor\")\n        assert(proxy:GetTarget() == target, \"invalid target leaves previous target intact\")\n    end\n    proxy:x(13)\n    target:x(7)\n    assert(proxy:GetX() == 13 and target:GetX() == 7, \"proxy position is independent\")\n    ActorProxy.ProxyAddedMethod = function(self) return self:GetTarget() end\n    assert(proxy:ProxyAddedMethod() == target, \"live class methods\")\n    ActorProxy.ProxyAddedMethod = nil\n    local original = Actor.GetX\n    Actor.GetX = function() return 91 end\n    local inherited = proxy:GetX()\n    Actor.GetX = original\n    assert(inherited == 91 and proxy:GetX() == 13, \"live base overrides\")\nend\n\nif native_proxy then\n    local own = {}\n    for name, method in pairs(ActorProxy) do\n        if type(method) == \"function\" then own[name] = true end\n    end\n    assert(own.SetTarget and own.GetTarget)\n    own.SetTarget, own.GetTarget = nil, nil\n    assert(next(own) == nil, \"exact native own method inventory\")\n    check_proxy(native_proxy, native_target)\nelse\n    return Def.ActorFrame{\n        OnCommand = function(self) check_proxy(self:GetChild(\"Proxy\"), self:GetChild(\"Target\")) end,\n        Def.ActorProxy{Name = \"Proxy\"},\n        Def.Actor{Name = \"Target\"},\n    }\nend\n", [])
test: invalid_targets_preserve_old_values_and_partial_classification_writes
("p=root[1];a=root[2];q=root[3]", [])
("p:SetTarget(a)", [])
("local old=p:GetTarget();assert(not pcall(p.SetTarget,p,nil));assert(p:GetTarget()==old)", [])
("local old=p:GetTarget();assert(not pcall(p.SetTarget,p,false));assert(p:GetTarget()==old)", [])
("local old=p:GetTarget();assert(not pcall(p.SetTarget,p,12));assert(p:GetTarget()==old)", [])
("local old=p:GetTarget();assert(not pcall(p.SetTarget,p,'target'));assert(p:GetTarget()==old)", [])
("local old=p:GetTarget();assert(not pcall(p.SetTarget,p,{}));assert(p:GetTarget()==old)", [])
("local old=p:GetTarget();assert(not pcall(p.SetTarget,p,{__songlua_actor_type=false}));assert(p:GetTarget()==old)", [])
("local old=p:GetTarget();assert(not pcall(p.SetTarget,p,{__songlua_actor_type=string.char(255)}));assert(p:GetTarget()==old)", [])
("local old=p:GetTarget();assert(not pcall(p.SetTarget,p,setmetatable({}, {__index=function() return 'Actor' end})));assert(p:GetTarget()==old)", [])
("\n            p:SetTarget(a);local target={__songlua_actor_type='Actor'}\n            if '__songlua_top_screen_child_name'=='__songlua_player_child_name' then target.__songlua_player_index=1 end\n            target['__songlua_top_screen_child_name']=false\n            assert(not pcall(p.SetTarget,p,target));assert(p:GetTarget()==target)\n            log(p.__songlua_proxy_target_kind,p.__songlua_proxy_player_index)\n        ", [110, 105, 108, 124, 110, 105, 108])
("\n            p:SetTarget(a);local target={__songlua_actor_type='Actor'}\n            if '__songlua_player_index'=='__songlua_player_child_name' then target.__songlua_player_index=1 end\n            target['__songlua_player_index']=false\n            assert(not pcall(p.SetTarget,p,target));assert(p:GetTarget()==target)\n            log(p.__songlua_proxy_target_kind,p.__songlua_proxy_player_index)\n        ", [110, 105, 108, 124, 110, 105, 108, 124, 110, 105, 108, 124, 110, 105, 108])
("\n            p:SetTarget(a);local target={__songlua_actor_type='Actor'}\n            if '__songlua_player_child_name'=='__songlua_player_child_name' then target.__songlua_player_index=1 end\n            target['__songlua_player_child_name']=false\n            assert(not pcall(p.SetTarget,p,target));assert(p:GetTarget()==target)\n            log(p.__songlua_proxy_target_kind,p.__songlua_proxy_player_index)\n        ", [110, 105, 108, 124, 110, 105, 108, 124, 110, 105, 108, 124, 110, 105, 108, 124, 110, 105, 108, 124, 49])
("p:SetTarget(a);local mt=getmetatable(p);local assign=mt.__newindex;p.__songlua_proxy_target_actor=nil;mt.__newindex=function(self,key,value) if key=='__songlua_proxy_target_actor' then collectgarbage();error('publication failure') end;rawset(self,key,value) end;assert(not pcall(p.SetTarget,p,a));assert(p:GetTarget()==nil);log(p.__songlua_proxy_target_kind,p.__songlua_proxy_player_index);mt.__newindex=assign", [110, 105, 108, 124, 110, 105, 108, 124, 110, 105, 108, 124, 110, 105, 108, 124, 110, 105, 108, 124, 49, 124, 110, 105, 108, 124, 110, 105, 108])
